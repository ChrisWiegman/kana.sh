/*
  x-frame-options: DENY
  x-permitted-cross-domain-policies: none
  x-content-type-options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  Link: </llms.txt>; rel="describedby"; type="text/plain", </sitemap.xml>; rel="sitemap"; type="application/xml"
  Permissions-Policy: microphone=(), geolocation=(), autoplay=(), camera=()
  Content-Security-Policy: default-src 'self'; base-uri 'self'; object-src 'none'; frame-ancestors 'none'; form-action 'self'; img-src 'self' data:; font-src 'self'; style-src 'self' 'unsafe-inline'; script-src 'self'; connect-src 'self'; upgrade-insecure-requests;
  Speculation-Rules: "/speculation-rules.json"

# Prefetch rules for same-site links (replaces Cloudflare Speed Brain, which skips Workers).
/speculation-rules.json
  ! Link
  ! Speculation-Rules
  Content-Type: application/speculationrules+json
  Cache-Control: public, max-age=86400

/sitemap.xml
  ! Content-Security-Policy
  ! Link
  Content-Security-Policy: default-src 'self'; base-uri 'self'; object-src 'none'; frame-ancestors 'none'; form-action 'self'; img-src 'self' data:; font-src 'self'; style-src 'self' 'unsafe-inline'; script-src 'self'; connect-src 'self'; upgrade-insecure-requests;

/index.xml
  ! Content-Security-Policy
  ! Link
  Content-Security-Policy: default-src 'self'; base-uri 'self'; object-src 'none'; frame-ancestors 'none'; form-action 'self'; img-src 'self' data:; font-src 'self'; style-src 'self' 'unsafe-inline'; script-src 'self'; connect-src 'self'; upgrade-insecure-requests;

/notes/index.xml
  ! Content-Security-Policy
  ! Link
  Content-Security-Policy: default-src 'self'; base-uri 'self'; object-src 'none'; frame-ancestors 'none'; form-action 'self'; img-src 'self' data:; font-src 'self'; style-src 'self' 'unsafe-inline'; script-src 'self'; connect-src 'self'; upgrade-insecure-requests;

# The Link header points agents to llms.txt and the sitemap; it only belongs on pages.
/.well-known/*
  ! Link

# Agent discovery files: CORS so browser-based agents can read them, and
# media types a static host can't infer from the file name.
/.well-known/api-catalog
  Content-Type: application/linkset+json; profile="https://www.rfc-editor.org/info/rfc9727"
  Access-Control-Allow-Origin: *

/.well-known/ard.json
  Access-Control-Allow-Origin: *

/.well-known/ai-catalog.json
  Access-Control-Allow-Origin: *

/.well-known/poppy.json
  Access-Control-Allow-Origin: *

/openapi.json
  ! Link
  Content-Type: application/vnd.oai.openapi+json
  Access-Control-Allow-Origin: *

/.well-known/mcp/server-card.json
  Content-Type: application/mcp-server-card+json
  Access-Control-Allow-Origin: *

/.well-known/agent-card.json
  Access-Control-Allow-Origin: *
  Cache-Control: public, max-age=3600

/llms.txt
  ! Link

/llms-full.txt
  ! Link

/robots.txt
  ! Link

/index.json
  ! Link

/indexnow.key
  ! Link

/Kana-Dark.zip
  ! Link

# Fingerprinted files: the name changes whenever the content does.
/css/*
  ! Link
  Cache-Control: public, max-age=31536000, immutable

/scripts/search.min.*
  Cache-Control: public, max-age=31536000, immutable

/scripts/*
  ! Link

# Files that keep their name when replaced: cache for a week.
/images/*
  ! Link
  Cache-Control: public, max-age=604800

/favicon.ico
  ! Link
  Cache-Control: public, max-age=604800

/favicon-16x16.png
  ! Link
  Cache-Control: public, max-age=604800

/favicon-32x32.png
  ! Link
  Cache-Control: public, max-age=604800

/apple-touch-icon.png
  ! Link
  Cache-Control: public, max-age=604800

/android-chrome-192x192.png
  ! Link
  Cache-Control: public, max-age=604800

/android-chrome-512x512.png
  ! Link
  Cache-Control: public, max-age=604800

/site.webmanifest
  ! Link
  Cache-Control: public, max-age=604800
