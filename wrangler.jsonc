{
  "name": "kana-sh",
  "compatibility_date": "2026-11-10",
  "preview_urls": true,
  // Read-only MCP server at /mcp; every other path is served as a static asset.
  "main": "themes/kana-hugo-theme/workers/mcp.mjs",
  "routes": [
    {
      "pattern": "kana.sh",
      "custom_domain": true
    }
  ],
  "assets": {
    "directory": "./public",
    "not_found_handling": "404-page",
    "html_handling": "auto-trailing-slash",
    "binding": "ASSETS",
    "run_worker_first": ["/mcp", "/mcp/*"]
  }
}
